# ============================================================================
# SAP B1 MCP — Konfiguration
#
# Diese Datei neben das Binary (sapb1-mcp / sapb1-mcp.exe) als ".env" kopieren
# und ausfüllen, dann starten mit:  sapb1-mcp --env-file .env --port 8000
#
# Legende:  [PFLICHT] = muss gesetzt sein · [Optional] = Default in (Klammern).
# Auskommentierte Zeilen (#) nutzen den Default. Vollständige Erläuterungen:
# docs/konfiguration.md
# ============================================================================


# --- Service Layer (Verbindung zu SAP B1) -----------------------------------

# [PFLICHT] Service-Layer-URL inkl. Version und abschließendem "/".
SAP_BASE_URL=https://ihr-sap-host:50000/b1s/v2/

# [PFLICHT] Wählbare CompanyDB(s) — eine oder mehrere, kommagetrennt.
SAP_DATABASES=SBO_IhreFirma

# [Optional] Zugriffsmodus (READ_ONLY). READ_WRITE schaltet die Schreib-Tools
# (anlegen/ändern/löschen) frei.
SAP_OPERATION_MODE=READ_ONLY

# [Optional] Mitgelieferte Auswertungen (AI_*-Abfragen) beim ersten Verbinden je
# CompanyDB ausbringen. Default true, benötigt READ_WRITE — im Lesebetrieb wird
# es übersprungen. Alternativ im Chat über sap_deploy_queries anstoßen.
SAP_AUTO_DEPLOY_QUERIES=true

# [Optional] Selbstsigniertes SL-Zertifikat akzeptieren (false). Für Produktion
# möglichst ein gültiges Zertifikat verwenden.
SAP_ALLOW_SELF_SIGNED_CERT=false

# [Optional] Maximale Zeilen pro Ergebnisseite (200).
SAP_MAX_PAGE_SIZE=200

# [Optional] Parallele Service-Layer-Requests (10).
SAP_MAX_CONCURRENT_REQUESTS=10

# [Optional] Timeout je SL-Request in Sekunden (60).
SAP_TIMEOUT_SECONDS=60

# [Optional] Automatischer Logout einer untätigen SL-Session in Sekunden (1500).
SAP_IDLE_LOGOUT_SECONDS=1500


# [Optional] Bind-Adressen des HTTP-Servers, kommagetrennt. Default: ALLE
# Interfaces (0.0.0.0) — andere Rechner erreichen den Server direkt; Firewall
# beachten. Nur lokal: SAP_BIND_HOSTS=127.0.0.1
# SAP_BIND_HOSTS=

# [Optional] TLS/HTTPS direkt im MCP (eingehende Client-Verbindungen). Beide
# Dateien (PEM) setzen -> Server spricht HTTPS; weglassen -> HTTP. Getrennt von
# SAP_ALLOW_SELF_SIGNED_CERT (das gilt AUSGEHEND zu SAP/Keycloak). Bei aktivem
# TLS SAP_PUBLIC_URL auf https://... setzen.
# SAP_TLS_CERT_FILE=C:\certs\mcp.crt
# SAP_TLS_KEY_FILE=C:\certs\mcp.key
# [Optional] Passwort, falls der private Schluessel verschluesselt ist.
# SAP_TLS_KEY_PASSWORD=
#
# --- TLS-Haertung (Rechenzentrum) ---
# [Optional] Mindest-TLS-Version: 1.2 (Default) oder 1.3.
# SAP_TLS_MIN_VERSION=1.2
# [Optional] OpenSSL-Cipher-String pinnen (nur TLS 1.2; leer = sichere Defaults).
# SAP_TLS_CIPHERS=
# [Optional] Client-CA (PEM) -> erzwingt Client-Zertifikate (mTLS).
# SAP_TLS_CLIENT_CA_FILE=

# --- Anmeldung ---------------------------------------------------------------

# [Optional] Prüfweg gegen die Service Layer:
#   basic (Default) = Benutzer/Passwort direkt an die SL (kein Keycloak).
#   bearer          = Browser-SSO über Keycloak (Auth Code + PKCE); das Token geht
#                     bei JEDEM Service-Layer-Aufruf mit. Passwort erreicht den
#                     MCP nie. Ab FP 2208 mit Tokens des SAP-Authentication-
#                     Servers; eigener Identity Provider als Aussteller nur
#                     nach Abstimmung (siehe docs/sso-keycloak.md).
# Bei bearer sind SAP_PUBLIC_URL + der IdP-Block unten PFLICHT; zusaetzlich
# SAP_SLD_URL (CompanyID) — oder, wenn EUER eigener Provider die Tokens
# ausstellt, stattdessen SAP_COMPANY_IDS (siehe docs/sso-keycloak.md).
# Einrichtung inkl. der SAP-seitigen Schritte: docs/sso-keycloak.md
SAP_AUTH_MODE=basic

# [Optional, EMPFOHLEN true] Login nur über Dialog (Elicit) bzw. Web-Login
# zulassen — nie als Chat-/Tool-Argument, damit Zugangsdaten nicht in den
# LLM-Kontext geraten.
SAP_DISABLE_INLINE_LOGIN=true

# [Optional] Öffentliche URL DIESER Instanz für den Browser-Login-Fallback
# (Hosts ohne native Eingabemaske, z. B. Claude Desktop). Daraus baut der Server
# die Login-URL <SAP_PUBLIC_URL>/login?t=…
#   LOKAL (gleiche Maschine): MIT Port → http://127.0.0.1:8000
#                             (Port MUSS zum Serverstart passen).
#   ZENTRAL/hinter Reverse-Proxy: die öffentliche HTTPS-URL → https://mcp.kunde.intern
#   (http:// ist nur für 127.0.0.1 erlaubt.)
SAP_PUBLIC_URL=http://127.0.0.1:8000


# --- Identity Provider / SSO — NUR bei SAP_AUTH_MODE=bearer -------------------
# Bei basic komplett weglassen. Client-ID/-Secret stammen aus dem Extension
# Single Sign-On Manager (Client Type "Web App", b1-ext-…). Die Redirect-URI
# <SAP_PUBLIC_URL>/callback muss dort hinterlegt sein.
# Vollständige Anleitung: docs/sso-keycloak.md
#
# EMPFOHLEN: Nur SAP_SLD_URL setzen — der Server ermittelt Token-, Authorize-,
# Logout- und Schlüssel-Endpunkt beim Start automatisch über die SLD.
#
# Stellt EUER eigener Identity Provider die Tokens aus (Principal Propagation),
# gilt stattdessen: SAP_IDP_TOKEN_URL auf euren Provider zeigen und die beim
# Tenant-Binding notierten CompanyIDs setzen —
#   SAP_COMPANY_IDS=SBO_PROD:1,SBO_TEST:2
# Dann wird die SLD nicht gebraucht (Port 40000 entbehrlich). Es muessen ALLE
# Datenbanken aus SAP_DATABASES aufgefuehrt sein, sonst startet der Server nicht.

# [PFLICHT wenn bearer] Client-ID (Extension Single Sign-On Manager).
# SAP_IDP_CLIENT_ID=b1-ext-web-xxxxxxxx

# [PFLICHT wenn bearer] Client-Secret (wird nur EINMAL angezeigt).
# SAP_IDP_CLIENT_SECRET=

# [PFLICHT wenn bearer] SLD-Adresse: CompanyID-Auflösung (X-b1-companyid) und
# automatische Ermittlung aller IdP-Endpunkte.
# SAP_SLD_URL=https://ihr-sap-host:40000

# [Alternative zu SAP_SLD_URL] Token-Endpoint des Keycloak-Realms explizit.
# SAP_IDP_TOKEN_URL=https://ihr-sap-host:40020/auth/realms/sapb1/protocol/openid-connect/token

# [Optional] OAuth-Scopes. Default 'openid' (wie die offiziellen SAP-Beispiele).
# Erweiterte Scopes nur setzen, wenn sie dem Client zugewiesen sind.
# SAP_IDP_SCOPE=openid

# [Optional] Authorize-Endpoint; sonst aus der Token-URL abgeleitet
# (…/token → …/auth). PFLICHT, wenn der Identity Provider kein Keycloak ist
# (z. B. Microsoft Entra ID, Okta).
# SAP_IDP_AUTHORIZE_URL=

# Hinweis: Die früheren Namen SAP_KEYCLOAK_TOKEN_URL / _CLIENT_ID / _CLIENT_SECRET
# / _AUTHORIZE_URL / _SCOPE funktionieren weiterhin (gleiche Bedeutung).


# --- Lizenz ------------------------------------------------------------------

# [Optional] Pfad zur Lizenzdatei. NICHT nötig, wenn "versino.key" neben dem
# Binary liegt (Auto-Discovery).
SAP_LICENSE_FILE=versino.key

# [Optional] Lizenz-Token direkt — Alternative zur Datei.
# SAP_LICENSE=<lizenz-token>


# --- Logging ----------------------------------------------------------------
#
# Warnungen/Fehler werden automatisch nach
#   %APPDATA%\Versino\sapb1-mcp\sapb1-mcp.log
# geschrieben (JSON-Zeilen, fester Pfad, nicht konfigurierbar). Die Datei ist
# auf 1 MB begrenzt — danach werden die aeltesten Eintraege entfernt.

# --- Phone-Home / automatische Abo-Erneuerung -------------------------------

# [Optional] Enrollment-Token für Phone-Home / automatische Abo-Erneuerung.
# NORMALFALL: bereits in der versino.key eingebacken — hier NICHTS nötig.
# Diese Variable nur setzen, um den eingebauten Token zu überschreiben
# (Test/Staging). Übertragen werden nur Metadaten (customer_id, edition,
# version, Seat-Anzahl), keine Geschäftsdaten. Air-gapped: kein Token →
# der ausgelieferte Schlüssel gilt unverändert bis zum Ablaufdatum.
# SAP_ENROLLMENT_TOKEN=<override-token>

# [Optional] Intervall der Phone-Home-Validierung in Sekunden (3600).
# SAP_PHONE_HOME_INTERVAL_SECONDS=3600

# [Optional] Pfad für erneuerte Token (stiller Renewal-Cache). Default:
# "versino.renewed" neben der Lizenz bzw. dem Binary.
# SAP_LICENSE_CACHE_FILE=versino.renewed

# [Optional] Pfad der Installations-Identität (install_identity.json).
# SAP_INSTALL_IDENTITY_PATH=install_identity.json

# [Optional] Monotoner Zeit-Anker gegen Uhr-Rückstellung (Härtung für
# air-gapped Betrieb). Ohne Pfad deaktiviert.
# SAP_TIME_ANCHOR_PATH=versino.timeanchor
