# ============================================================================
# SAP B1 MCP — konfigurace
#
# Zkopírujte tento soubor vedle binárky (sapb1-mcp / sapb1-mcp.exe) jako
# ".env", vyplňte a spusťte:  sapb1-mcp --env-file .env --port 8000
#
# Legenda:  [POVINNÉ] = musí být nastaveno · [Volitelné] = výchozí v (závorce).
# Zakomentované řádky (#) používají výchozí hodnotu. Úplný přehled:
# docs/konfiguration.cs.md
# ============================================================================


# --- Service Layer (připojení k SAP B1) --------------------------------------

# [POVINNÉ] URL Service Layeru vč. verze a koncového "/".
SAP_BASE_URL=https://ihr-sap-host:50000/b1s/v2/

# [POVINNÉ] Volitelné CompanyDB — jedna nebo více, oddělené čárkou.
SAP_DATABASES=SBO_IhreFirma

# [Volitelné] Režim přístupu (READ_ONLY). READ_WRITE zpřístupní zapisovací
# nástroje (vytvořit/změnit/smazat); v READ_ONLY se vůbec nenabízejí.
# Po změně server restartujte.
SAP_OPERATION_MODE=READ_ONLY

# [Volitelné] Nasadit dodané přehledy (dotazy AI_*) při prvním připojení pro
# každou CompanyDB. Výchozí true, vyžaduje READ_WRITE a edici, která reporty umí
# spustit — v režimu čtení a u edic pro kmenová data (BASIC) se přeskočí.
# Alternativně spusťte v chatu přes sap_deploy_queries.
SAP_AUTO_DEPLOY_QUERIES=true

# [Volitelné] Akceptovat self-signed certifikát SL (false). V produkci pokud
# možno používejte platný certifikát.
SAP_ALLOW_SELF_SIGNED_CERT=false

# [Volitelné] Maximum řádků na stránku výsledků (200).
SAP_MAX_PAGE_SIZE=200

# [Volitelné] Souběžné požadavky na Service Layer (10).
SAP_MAX_CONCURRENT_REQUESTS=10

# [Volitelné] Timeout jednoho požadavku SL v sekundách (60).
SAP_TIMEOUT_SECONDS=60

# [Volitelné] Automatické odhlášení nečinné relace SL v sekundách (1500).
SAP_IDLE_LOGOUT_SECONDS=1500

# [Volitelné] Přepsat typ databáze (HANA / MSSQL). Běžně se rozpozná
# automaticky — nastavte jen při chybné detekci.
# SAP_DB_SERVER_TYPE=HANA

# [Volitelné] Jazyk zpráv serveru (start exe, web login, chyby ověření):
# de (výchozí), en nebo cs. NEOVLIVŇUJE odpovědi asistenta v chatu (ty
# automaticky sledují jazyk uživatele).
# SAP_LANG=de

# [Volitelné] Adresy, na kterých HTTP server naslouchá, oddělené čárkou.
# Výchozí: VŠECHNA rozhraní (0.0.0.0) — ostatní počítače se připojí přímo;
# pozor na firewall. Jen lokálně: SAP_BIND_HOSTS=127.0.0.1
# SAP_BIND_HOSTS=

# [Volitelné] TLS/HTTPS přímo v MCP (příchozí spojení klientů). Nastavte oba
# soubory (PEM) -> server mluví HTTPS; vynechte -> HTTP. Odděleno od
# SAP_ALLOW_SELF_SIGNED_CERT (to platí ODCHOZÍM směrem k SAP/Keycloaku). Při
# zapnutém TLS nastavte SAP_PUBLIC_URL na https://...
# SAP_TLS_CERT_FILE=C:\certs\mcp.crt
# SAP_TLS_KEY_FILE=C:\certs\mcp.key

# [Volitelné] Heslo, pokud je privátní klíč šifrovaný.
# SAP_TLS_KEY_PASSWORD=

# Zpřísnění TLS (datové centrum):
# [Volitelné] Minimální verze TLS: 1.2 (výchozí) nebo 1.3.
# SAP_TLS_MIN_VERSION=1.2

# [Volitelné] Pevný OpenSSL cipher string (jen TLS 1.2; prázdné = bezpečné výchozí).
# SAP_TLS_CIPHERS=

# [Volitelné] Klientská CA (PEM) -> vynutí klientské certifikáty (mTLS).
# SAP_TLS_CLIENT_CA_FILE=



# --- Přihlášení --------------------------------------------------------------

# [Volitelné] Způsob ověření vůči Service Layeru:
#   basic (výchozí) = uživatel/heslo přímo na SL (bez Keycloaku).
#   bearer          = browser SSO přes Keycloak (Auth Code + PKCE); token se
#                     posílá s KAŽDÝM voláním Service Layeru. Heslo se do MCP
#                     nikdy nedostane. Od FP 2208 s tokeny SAP Authentication
#                     Serveru; vlastní identity provider jako vydavatel jen
#                     po dohodě (viz docs/sso-keycloak.cs.md).
# U bearer jsou SAP_PUBLIC_URL + blok IdP níže POVINNÉ; navíc SAP_SLD_URL
# (CompanyID) — nebo, pokud tokeny vydává VÁŠ vlastní provider, místo toho
# SAP_COMPANY_IDS (viz docs/sso-keycloak.cs.md).
# Nastavení vč. kroků na straně SAP: docs/sso-keycloak.cs.md
SAP_AUTH_MODE=basic

# [Volitelné, DOPORUČENO true] Povolit přihlášení jen dialogem (elicit) nebo
# web loginem — nikdy jako argument chatu/nástroje, aby se přihlašovací
# údaje nedostaly do kontextu LLM.
SAP_DISABLE_INLINE_LOGIN=true

# [Volitelné] Veřejná URL TÉTO instance pro záložní přihlášení prohlížečem
# (hosté bez nativního dialogu, např. Claude Desktop). Server z ní staví
# přihlašovací URL <SAP_PUBLIC_URL>/login#t=…
#   LOKÁLNĚ (stejný stroj): S portem → http://127.0.0.1:8000
#                           (port MUSÍ odpovídat startu serveru).
#   CENTRÁLNĚ/za reverse proxy: veřejná HTTPS URL → https://mcp.zakaznik.internal
#   (http:// je povoleno jen pro 127.0.0.1.)
SAP_PUBLIC_URL=http://127.0.0.1:8000

# [Volitelné] Zabezpečení přihlášení. SAP_TRUSTED_PROXIES: adresy reverse
# proxy (IP/CIDR, oddělené čárkou), jejichž X-Forwarded-For platí pro
# omezení přihlášení a audit log (prázdné = socket peer).
# SAP_LOGIN_MAX_FAILURES (10) neúspěchů z adresy během
# SAP_LOGIN_WINDOW_SECONDS (900) -> pauza 30 s, zdvojnásobuje se až do
# 15 min. SAP_TICKET_ISSUE_PER_MINUTE (60): globální strop přihlašovacích
# odkazů, navíc čtvrtina z toho na adresu. SAP_SESSION_MAX_SECONDS (28800):
# absolutní délka relace, 0 = bez omezení. SAP_TICKET_SESSION_MAX_SECONDS
# (3600): kratší mez pro relace oslovené klíčem z přihlášení v prohlížeči
# (ten putoval chatem), 0 = vypnuto; platí kratší z obou.
# SAP_TRUSTED_PROXIES=127.0.0.1
# SAP_LOGIN_MAX_FAILURES=10
# SAP_LOGIN_WINDOW_SECONDS=900
# SAP_TICKET_ISSUE_PER_MINUTE=60
# SAP_SESSION_MAX_SECONDS=28800
# SAP_TICKET_SESSION_MAX_SECONDS=3600

# [Volitelné] Sitová hranice. SAP_ALLOWED_CLIENTS: adresy/site (IP/CIDR,
# oddelene carkou), ktere smeji server vubec oslovit; prazdne (vychozi) =
# kazdy, kdo dosahne na port. Neni to prihlaseni — to zustava
# uzivatel/heslo/databaze —, jen to odstrani otevreny internet. U centralni
# instalace nastavte, nebo dejte server za reverse proxy. Preklep ukonci
# start misto tiche blokace vsech.
# SAP_ALLOWED_CLIENTS=10.0.0.0/8,192.168.1.0/24



# --- Identity provider / SSO — JEN při SAP_AUTH_MODE=bearer ------------------

# U basic zcela vynechte. Client id/secret pochází z Extension Single
# Sign-On Manageru (typ klienta "Web App", b1-ext-…). Redirect URI
# <SAP_PUBLIC_URL>/callback tam musí být zaregistrována.
# Úplný návod: docs/sso-keycloak.cs.md
#
# DOPORUČENO: nastavte jen SAP_SLD_URL — server při startu automaticky zjistí
# token, authorize, logout a klíčové endpointy přes SLD.
#
# Pokud tokeny vydává VÁŠ vlastní identity provider (principal propagation),
# nasměrujte místo toho SAP_IDP_TOKEN_URL na svého providera a nastavte
# CompanyID poznamenané při tenant bindingu —
#   SAP_COMPANY_IDS=SBO_PROD:1,SBO_TEST:2
# SLD pak není potřeba (port 40000 postradatelný). Musí být uvedeny VŠECHNY
# databáze ze SAP_DATABASES, jinak server nenastartuje.

# [POVINNÉ při bearer] Client id (Extension Single Sign-On Manager).
# SAP_IDP_CLIENT_ID=b1-ext-web-xxxxxxxx

# [POVINNÉ při bearer] Client secret (zobrazí se jen JEDNOU).
# SAP_IDP_CLIENT_SECRET=

# [POVINNÉ při bearer] Adresa SLD: překlad CompanyID (X-b1-companyid) a
# automatické zjištění všech endpointů IdP.
# SAP_SLD_URL=https://ihr-sap-host:40000

# [Alternativa k SAP_SLD_URL] Token endpoint Keycloak realmu, explicitně.
# SAP_IDP_TOKEN_URL=https://ihr-sap-host:40020/auth/realms/sapb1/protocol/openid-connect/token

# [Volitelné] OAuth scopes. Výchozí 'openid' (jako oficiální ukázky SAP).
# Rozšířené scopes nastavte jen tehdy, jsou-li klientovi přiřazeny.
# SAP_IDP_SCOPE=openid

# [Volitelné] Authorize endpoint; jinak odvozen z token URL
# (…/token → …/auth). POVINNÉ, pokud identity provider není Keycloak
# (např. Microsoft Entra ID, Okta).
# SAP_IDP_AUTHORIZE_URL=

# [Volitelné] Další endpointy IdP. Běžně se zjistí automaticky přes
# SAP_SLD_URL — nastavte jen tehdy, je-li nutné automatiku přepsat:
# SAP_IDP_ISSUER=
# SAP_IDP_JWKS_URL=
# SAP_IDP_END_SESSION_URL=
# SAP_IDP_REVOCATION_URL=

# Poznámka: dřívější názvy SAP_KEYCLOAK_TOKEN_URL / _CLIENT_ID / _CLIENT_SECRET
# / _AUTHORIZE_URL / _SCOPE fungují nadále (stejný význam).



# --- Přílohy (nahrávání souborů odkazem) -------------------------------------

# [Volitelné] Maximální velikost souboru pro nahrání přílohy v MB (stránka
# nahrání v prohlížeči, source_url, file_path). Výchozí 25. Detaily: docs/anhaenge.cs.md
# SAP_UPLOAD_MAX_MB=25

# [Volitelné] Hostitelé, ze kterých smí sap_attachment stáhnout source_url,
# oddělené čárkou ("host" nebo "*.domain"). Prázdné = cesta vypnuta. Pouze
# HTTPS, žádné privátní adresy, žádná přesměrování.
# SAP_ATTACHMENT_URL_ALLOWLIST=files.example.com,*.sharepoint.com

# [Volitelné] Adresář, pod kterým smí sap_attachment číst file_path (lokální
# instalace / síťové sdílení). Prázdné = cesta vypnuta.
# SAP_ATTACHMENT_DIR=C:\sapb1-mcp\attachments



# --- Licence -----------------------------------------------------------------

# [Volitelné] Cesta k licenčnímu souboru. NENÍ potřeba, pokud "versino.key"
# leží vedle binárky (auto-discovery).
SAP_LICENSE_FILE=versino.key

# [Volitelné] Licenční token přímo — alternativa k souboru.
# SAP_LICENSE=<lizenz-token>



# --- Logování ----------------------------------------------------------------

# Varování/chyby se automaticky zapisují do
#   %APPDATA%\Versino\sapb1-mcp\sapb1-mcp.log
# (řádky JSON, pevná cesta, nekonfigurovatelné). Soubor je omezen na 1 MB —
# poté se nejstarší záznamy odstraní.



# --- Phone-home / automatické obnovení předplatného --------------------------

# [Volitelné] Enrollment token pro phone-home / automatické obnovení
# předplatného. BĚŽNĚ už zapečen ve versino.key — zde NENÍ potřeba nic.
# Tuto proměnnou nastavte jen pro přepsání vestavěného tokenu (test/staging).
# Přenášejí se pouze metadata (customer_id, edice, verze, počet seatů),
# žádná obchodní data. Air-gapped: bez tokenu → dodaný klíč platí beze změny
# do data expirace.
# SAP_ENROLLMENT_TOKEN=<override-token>

# [Volitelné] Interval validace phone-home v sekundách (3600).
# SAP_PHONE_HOME_INTERVAL_SECONDS=3600

# [Volitelné] Cesta pro obnovené tokeny (tichá renewal cache). Výchozí:
# "versino.renewed" vedle licence, resp. binárky.
# SAP_LICENSE_CACHE_FILE=versino.renewed

# [Volitelné] Cesta identity instalace (install_identity.json).
# Výchozí hodnota je RELATIVNÍ k pracovnímu adresáři. V kontejneru s
# read-only rootfs nebo v pomíjivém adresáři zde musí být trvalá cesta —
# jinak zápis selže, případně se při každém startu vytvoří nový klíčový pár
# a instalace se registruje znovu.
# SAP_INSTALL_IDENTITY_PATH=/data/install_identity.json

# [Volitelné] Monotónní časová kotva proti vrácení hodin (zpřísnění pro
# air-gapped provoz). Bez cesty vypnuto.
# SAP_TIME_ANCHOR_PATH=versino.timeanchor
