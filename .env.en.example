# ============================================================================
# SAP B1 MCP — configuration
#
# Copy this file next to the binary (sapb1-mcp / sapb1-mcp.exe) as ".env",
# fill it in, then start with:  sapb1-mcp --env-file .env --port 8000
#
# Legend:  [REQUIRED] = must be set · [Optional] = default in (parentheses).
# Commented lines (#) use the default. Full reference: docs/konfiguration.md
# ============================================================================


# --- Service Layer (connection to SAP B1) ------------------------------------

# [REQUIRED] Service Layer URL incl. version and trailing "/".
SAP_BASE_URL=https://ihr-sap-host:50000/b1s/v2/

# [REQUIRED] Selectable CompanyDB(s) — one or more, comma-separated.
SAP_DATABASES=SBO_IhreFirma

# [Optional] Access mode (READ_ONLY). READ_WRITE enables the write tools
# (create/update/delete).
SAP_OPERATION_MODE=READ_ONLY

# [Optional] Deploy the bundled reports (AI_* queries) on first connect per
# CompanyDB. Default true, requires READ_WRITE — skipped in read-only mode.
# Alternatively trigger via sap_deploy_queries in the chat.
SAP_AUTO_DEPLOY_QUERIES=true

# [Optional] Accept a self-signed SL certificate (false). Use a valid
# certificate in production whenever possible.
SAP_ALLOW_SELF_SIGNED_CERT=false

# [Optional] Maximum rows per result page (200).
SAP_MAX_PAGE_SIZE=200

# [Optional] Parallel Service Layer requests (10).
SAP_MAX_CONCURRENT_REQUESTS=10

# [Optional] Timeout per SL request in seconds (60).
SAP_TIMEOUT_SECONDS=60

# [Optional] Automatic logout of an idle SL session in seconds (1500).
SAP_IDLE_LOGOUT_SECONDS=1500

# [Optional] Override the database type (HANA / MSSQL). Normally detected
# automatically — set only if detection is wrong.
# SAP_DB_SERVER_TYPE=HANA

# [Optional] Language of the server messages (exe startup, web login, auth
# errors): de (default), en or cs. Does NOT affect the assistant's chat
# replies (those automatically follow the user's language).
# SAP_LANG=de

# [Optional] Bind addresses of the HTTP server, comma-separated. Default: ALL
# interfaces (0.0.0.0) — other machines reach the server directly; mind the
# firewall. Local only: SAP_BIND_HOSTS=127.0.0.1
# SAP_BIND_HOSTS=

# [Optional] TLS/HTTPS directly in the MCP (inbound client connections). Set
# both files (PEM) -> server speaks HTTPS; omit -> HTTP. Separate from
# SAP_ALLOW_SELF_SIGNED_CERT (which applies OUTBOUND to SAP/Keycloak). With
# TLS on, set SAP_PUBLIC_URL to https://...
# SAP_TLS_CERT_FILE=C:\certs\mcp.crt
# SAP_TLS_KEY_FILE=C:\certs\mcp.key

# [Optional] Password if the private key is encrypted.
# SAP_TLS_KEY_PASSWORD=

# TLS hardening (data center):
# [Optional] Minimum TLS version: 1.2 (default) or 1.3.
# SAP_TLS_MIN_VERSION=1.2

# [Optional] Pin an OpenSSL cipher string (TLS 1.2 only; empty = safe defaults).
# SAP_TLS_CIPHERS=

# [Optional] Client CA (PEM) -> requires client certificates (mTLS).
# SAP_TLS_CLIENT_CA_FILE=



# --- Authentication ----------------------------------------------------------

# [Optional] Authentication path against the Service Layer:
#   basic (default) = user/password straight to the SL (no Keycloak).
#   bearer          = browser SSO via Keycloak (Auth Code + PKCE); the token is
#                     sent with EVERY Service Layer call. The password never
#                     reaches the MCP. From FP 2208 with tokens of the SAP
#                     Authentication Server; your own identity provider as
#                     issuer only after alignment (see docs/sso-keycloak.md).
# With bearer, SAP_PUBLIC_URL + the IdP block below are REQUIRED; additionally
# SAP_SLD_URL (CompanyID) — or, if YOUR own provider issues the tokens,
# SAP_COMPANY_IDS instead (see docs/sso-keycloak.md).
# Setup incl. the SAP-side steps: docs/sso-keycloak.md
SAP_AUTH_MODE=basic

# [Optional, RECOMMENDED true] Allow login only via dialog (elicit) or web
# login — never as a chat/tool argument, so credentials never enter the
# LLM context.
SAP_DISABLE_INLINE_LOGIN=true

# [Optional] Public URL of THIS instance for the browser-login fallback
# (hosts without a native input dialog, e.g. Claude Desktop). The server
# builds the login URL <SAP_PUBLIC_URL>/login?t=… from it.
#   LOCAL (same machine): WITH port → http://127.0.0.1:8000
#                         (the port MUST match the server start).
#   CENTRAL/behind a reverse proxy: the public HTTPS URL → https://mcp.customer.internal
#   (http:// is allowed for 127.0.0.1 only.)
SAP_PUBLIC_URL=http://127.0.0.1:8000



# --- Identity provider / SSO — ONLY with SAP_AUTH_MODE=bearer ----------------

# Omit entirely with basic. Client id/secret come from the Extension
# Single Sign-On Manager (client type "Web App", b1-ext-…). The redirect URI
# <SAP_PUBLIC_URL>/callback must be registered there.
# Full guide: docs/sso-keycloak.md
#
# RECOMMENDED: set only SAP_SLD_URL — the server discovers the token,
# authorize, logout and key endpoints automatically via the SLD at startup.
#
# If YOUR own identity provider issues the tokens (principal propagation),
# instead point SAP_IDP_TOKEN_URL at your provider and set the CompanyIDs
# noted during tenant binding —
#   SAP_COMPANY_IDS=SBO_PROD:1,SBO_TEST:2
# The SLD is then not needed (port 40000 dispensable). ALL databases from
# SAP_DATABASES must be listed, otherwise the server refuses to start.

# [REQUIRED with bearer] Client id (Extension Single Sign-On Manager).
# SAP_IDP_CLIENT_ID=b1-ext-web-xxxxxxxx

# [REQUIRED with bearer] Client secret (shown only ONCE).
# SAP_IDP_CLIENT_SECRET=

# [REQUIRED with bearer] SLD address: CompanyID resolution (X-b1-companyid)
# and automatic discovery of all IdP endpoints.
# SAP_SLD_URL=https://ihr-sap-host:40000

# [Alternative to SAP_SLD_URL] Token endpoint of the Keycloak realm, explicit.
# SAP_IDP_TOKEN_URL=https://ihr-sap-host:40020/auth/realms/sapb1/protocol/openid-connect/token

# [Optional] OAuth scopes. Default 'openid' (like the official SAP samples).
# Set extended scopes only if they are assigned to the client.
# SAP_IDP_SCOPE=openid

# [Optional] Authorize endpoint; otherwise derived from the token URL
# (…/token → …/auth). REQUIRED when the identity provider is not a Keycloak
# (e.g. Microsoft Entra ID, Okta).
# SAP_IDP_AUTHORIZE_URL=

# [Optional] Further IdP endpoints. Normally discovered automatically via
# SAP_SLD_URL — set only when the auto-discovery must be overridden:
# SAP_IDP_ISSUER=
# SAP_IDP_JWKS_URL=
# SAP_IDP_END_SESSION_URL=
# SAP_IDP_REVOCATION_URL=

# Note: the former names SAP_KEYCLOAK_TOKEN_URL / _CLIENT_ID / _CLIENT_SECRET
# / _AUTHORIZE_URL / _SCOPE keep working (same meaning).



# --- Attachments (file upload by reference) ----------------------------------

# [Optional] Maximum file size per attachment upload in MB (browser upload
# page, source_url, file_path). Default 25. Details: docs/anhaenge.md
# SAP_UPLOAD_MAX_MB=25

# [Optional] Hosts sap_attachment may fetch a source_url from, comma-separated
# ("host" or "*.domain"). Empty = this way is disabled. HTTPS only, no private
# addresses, no redirects.
# SAP_ATTACHMENT_URL_ALLOWLIST=files.example.com,*.sharepoint.com

# [Optional] Directory below which sap_attachment may read a file_path (local
# install / network share). Empty = this way is disabled.
# SAP_ATTACHMENT_DIR=C:\sapb1-mcp\attachments



# --- License -----------------------------------------------------------------

# [Optional] Path to the license file. NOT needed when "versino.key" sits
# next to the binary (auto-discovery).
SAP_LICENSE_FILE=versino.key

# [Optional] License token inline — alternative to the file.
# SAP_LICENSE=<lizenz-token>



# --- Logging -----------------------------------------------------------------

# Warnings/errors are written automatically to
#   %APPDATA%\Versino\sapb1-mcp\sapb1-mcp.log
# (JSON lines, fixed path, not configurable). The file is capped at 1 MB —
# beyond that the oldest entries are pruned.



# --- Phone-home / automatic subscription renewal -----------------------------

# [Optional] Enrollment token for phone-home / automatic subscription renewal.
# NORMALLY already baked into versino.key — NOTHING needed here.
# Set this variable only to override the built-in token (test/staging).
# Only metadata is transmitted (customer_id, edition, version, seat count),
# no business data. Air-gapped: no token → the delivered key stays valid
# unchanged until its expiry date.
# SAP_ENROLLMENT_TOKEN=<override-token>

# [Optional] Interval of the phone-home validation in seconds (3600).
# SAP_PHONE_HOME_INTERVAL_SECONDS=3600

# [Optional] Path for renewed tokens (silent renewal cache). Default:
# "versino.renewed" next to the license or the binary.
# SAP_LICENSE_CACHE_FILE=versino.renewed

# [Optional] Path of the installation identity (install_identity.json).
# The default is RELATIVE to the working directory. In a container with a
# read-only rootfs, or on an ephemeral directory, set a persistent path here
# — otherwise the write fails, or a fresh keypair is created on every start
# and the installation registers itself again each time.
# SAP_INSTALL_IDENTITY_PATH=/data/install_identity.json

# [Optional] Monotonic time anchor against clock rollback (hardening for
# air-gapped operation). Disabled without a path.
# SAP_TIME_ANCHOR_PATH=versino.timeanchor
